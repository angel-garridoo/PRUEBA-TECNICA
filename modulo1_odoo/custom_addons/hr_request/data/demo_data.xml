<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Solicitud pendiente para validar el flujo inicial y los botones de accion. -->
    <record id="hr_request_demo_1" model="hr.request">
        <field name="nombre">Solicitud de Vacaciones Diciembre</field>
        <field name="tipo">vacaciones</field>
        <field name="empleado_id" ref="hr.employee_admin"/>
        <field name="fecha_solicitud">2024-11-15</field>
        <field name="estado">nuevo</field>
        <field name="observaciones">
            Solicito 15 días de vacaciones del 16 al 31 de diciembre de 2024.
        </field>
    </record>

    <!-- Solicitud aprobada para comprobar estados y decoraciones de la vista lista. -->
    <record id="hr_request_demo_2" model="hr.request">
        <field name="nombre">Permiso por Cita Médica</field>
        <field name="tipo">permiso</field>
        <field name="empleado_id" ref="hr.employee_admin"/>
        <field name="fecha_solicitud">2024-10-20</field>
        <field name="estado">aprobado</field>
        <field name="observaciones">
            Permiso de medio día para cita médica especializada.
        </field>
    </record>

    <!-- Solicitud rechazada para probar filtros, busqueda y colores por estado. -->
    <record id="hr_request_demo_3" model="hr.request">
        <field name="nombre">Anticipo de Nómina Octubre</field>
        <field name="tipo">anticipo</field>
        <field name="empleado_id" ref="hr.employee_admin"/>
        <field name="fecha_solicitud">2024-10-01</field>
        <field name="estado">rechazado</field>
        <field name="observaciones">
            Solicito anticipo del 50% de la nómina de octubre por urgencia familiar.
        </field>
    </record>

</odoo>
