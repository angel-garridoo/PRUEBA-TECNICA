<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_request_view_form" model="ir.ui.view">
        <field name="name">hr.request.view.form</field>
        <field name="model">hr.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud Interna">

                <header>

                    <button
                        name="action_aprobar"
                        string="Aprobar"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('estado', '!=', 'nuevo')]}"/>

                    <button
                        name="action_rechazar"
                        string="Rechazar"
                        type="object"
                        class="btn-danger"
                        attrs="{'invisible': [('estado', '!=', 'nuevo')]}"/>

                    <field
                        name="estado"
                        widget="statusbar"
                        statusbar_visible="nuevo,aprobado,rechazado"/>
                </header>

                <sheet>
                    <group>
                        <group string="Información General">
                            <field name="nombre"/>
                            <field name="tipo"/>
                            <field name="empleado_id"/>
                            <field name="fecha_solicitud"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Observaciones">
                            <field
                                name="observaciones"
                                placeholder="Escribe aquí detalles adicionales sobre la solicitud..."/>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>

    <record id="hr_request_view_list" model="ir.ui.view">
        <field name="name">hr.request.view.list</field>
        <field name="model">hr.request</field>
        <field name="arch" type="xml">
            <tree string="Solicitudes Internas"
                  decoration-success="estado == 'aprobado'"
                  decoration-danger="estado == 'rechazado'"
                  decoration-info="estado == 'nuevo'">
                <field name="nombre"/>
                <field name="tipo"/>
                <field name="empleado_id"/>
                <field name="fecha_solicitud"/>
                <field name="estado"/>
            </tree>
        </field>
    </record>

    <record id="hr_request_view_search" model="ir.ui.view">
        <field name="name">hr.request.view.search</field>
        <field name="model">hr.request</field>
        <field name="arch" type="xml">
            <search string="Buscar Solicitudes">

                <field name="nombre"/>
                <field name="empleado_id"/>

                <filter
                    string="Nuevas"
                    name="filter_nuevo"
                    domain="[('estado', '=', 'nuevo')]"/>
                <filter
                    string="Aprobadas"
                    name="filter_aprobado"
                    domain="[('estado', '=', 'aprobado')]"/>
                <filter
                    string="Rechazadas"
                    name="filter_rechazado"
                    domain="[('estado', '=', 'rechazado')]"/>
                <separator/>

                <filter
                    string="Vacaciones"
                    name="filter_vacaciones"
                    domain="[('tipo', '=', 'vacaciones')]"/>
                <filter
                    string="Permisos"
                    name="filter_permiso"
                    domain="[('tipo', '=', 'permiso')]"/>
                <filter
                    string="Anticipos"
                    name="filter_anticipo"
                    domain="[('tipo', '=', 'anticipo')]"/>
                <group expand="0" string="Agrupar por">
                    <filter
                        string="Empleado"
                        name="group_empleado"
                        context="{'group_by': 'empleado_id'}"/>
                    <filter
                        string="Estado"
                        name="group_estado"
                        context="{'group_by': 'estado'}"/>
                    <filter
                        string="Tipo"
                        name="group_tipo"
                        context="{'group_by': 'tipo'}"/>
                </group>

            </search>
        </field>
    </record>


    <record id="hr_request_action" model="ir.actions.act_window">
        <field name="name">Solicitudes Internas</field>
        <field name="res_model">hr.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="xml">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera solicitud interna!
            </p>
            <p>
                Registra solicitudes de vacaciones, permisos, anticipos y más.
            </p>
        </field>
    </record>

</odoo>