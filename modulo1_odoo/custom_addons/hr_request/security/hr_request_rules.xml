<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Usuarios internos: solo ven y editan solicitudes asociadas a su empleado. -->
    <record id="hr_request_rule_employee" model="ir.rule">
        <field name="name">Empleados: solo sus solicitudes</field>
        <field name="model_id" ref="model_hr_request"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">
            [('empleado_id.user_id', '=', user.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Administradores: acceso completo para gestionar todas las solicitudes. -->
    <record id="hr_request_rule_manager" model="ir.rule">
        <field name="name">Administradores: todas las solicitudes</field>
        <field name="model_id" ref="model_hr_request"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
